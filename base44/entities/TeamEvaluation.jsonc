      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "defending_organized": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "defending_final_third": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "defending_transition": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "pressing": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "defending_set_pieces": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "attacking_organized": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "attacking_final_third": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "attacking_in_transition": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "building_out": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "attacking_set_pieces": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
