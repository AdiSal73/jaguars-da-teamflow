{
  "name": "TrainingFeedback",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string",
      "description": "Reference to player"
    },
    "module_id": {
      "type": "string",
      "description": "Reference to training module"
    },
    "session_date": {
      "type": "string",
      "format": "date"
    },
    "perceived_exertion": {
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "description": "RPE scale 1-10"
    },
    "completion_status": {
      "type": "string",
      "enum": [
        "Completed",
        "Partial",
        "Skipped"
      ],
      "default": "Completed"
    },
    "session_notes": {
      "type": "string",
      "description": "Player notes on the session"
    },
    "felt_difficulty": {
      "type": "string",
      "enum": [
        "Too Easy",
        "Just Right",
        "Too Hard"
      ],
      "default": "Just Right"
    },
    "energy_level_before": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "energy_level_after": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "enjoyed_session": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "player_id",
    "module_id",
    "session_date"
  ]
}