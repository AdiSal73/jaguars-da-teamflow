{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User who should receive this notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "game",
        "training",
        "assessment",
        "evaluation",
        "performance",
        "goal",
        "training_plan",
        "message",
        "announcement"
      ],
      "description": "Type of notification"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message content"
    },
    "link": {
      "type": "string",
      "description": "Optional link to related page"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    }
  },
  "required": [
    "user_email",
    "type",
    "title",
    "message"
  ]
}