{
  "name": "InjuryRecord",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string",
      "description": "Reference to player"
    },
    "injury_type": {
      "type": "string",
      "description": "Type of injury (e.g., Ankle Sprain, Hamstring Strain)"
    },
    "injury_date": {
      "type": "string",
      "format": "date",
      "description": "Date injury occurred"
    },
    "recovery_date": {
      "type": "string",
      "format": "date",
      "description": "Expected or actual recovery date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Recovering",
        "Recovered"
      ],
      "default": "Active",
      "description": "Current injury status"
    },
    "severity": {
      "type": "string",
      "enum": [
        "Minor",
        "Moderate",
        "Severe"
      ],
      "description": "Injury severity level"
    },
    "treatment_notes": {
      "type": "string",
      "description": "Treatment plan and recovery notes"
    },
    "rehabilitation_exercises": {
      "type": "array",
      "description": "Recommended rehabilitation exercises",
      "items": {
        "type": "object",
        "properties": {
          "exercise_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "sets_reps": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          }
        }
      }
    },
    "return_to_play_protocol": {
      "type": "array",
      "description": "Phases of return to play",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string"
          },
          "activities": {
            "type": "string"
          },
          "completion_date": {
            "type": "string",
            "format": "date"
          },
          "completed": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "required": [
    "player_id",
    "injury_type",
    "injury_date"
  ]
}